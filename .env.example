# Copy to .env and fill in. .env is gitignored and must never be committed.

# SMTP server of the sending account's provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The DEDICATED SENDER account. This is the mailbox the website sends *from*.
# It needs 2-Step Verification enabled and an App Password generated on it.
# It is not read by a person and is not where enquiries land.
SMTP_USER=zendia.website@gmail.com

# The 16-character App Password generated on SMTP_USER's account.
# Never the account's own login password. Never committed to git.
SMTP_PASS=

# The RECIPIENT. Where enquiries actually arrive. Gives up no credentials.
# Comma-separate to deliver to more than one address.
CONTACT_TO=ZENDIA.office@gmail.com
